# Copy to .env (never commit .env). The backend and CLI load it at startup.

# OpenAI: used ONLY when you click "Run Weekly Analysis" (or run main.py --weekly).
OPENAI_API_KEY=

# eBay seller OAuth (see docs/setup.md). Run `python ebay_auth.py` to fill EBAY_REFRESH_TOKEN.
# The consent must include sell.fulfillment.readonly and sell.finances.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# Optional short-lived seller user token; refresh credentials preferred.
EBAY_ACCESS_TOKEN=
# production or sandbox
EBAY_ENVIRONMENT=production
# eBay RuName, used only by the one-time ebay_auth.py helper.
EBAY_REDIRECT_URI=

# Gmail needs no .env entries: save the Google OAuth desktop client JSON to
# secrets/gmail_client.json and run `python -m backend.integrations.gmail.auth`.
